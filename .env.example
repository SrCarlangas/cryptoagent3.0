# BTC Decision Agent — environment template (names only; never commit real values)
# Copy to .env and fill locally. .env is gitignored.

# --- Binance demo execution (https://demo-api.binance.com, no real funds) ---
# Create demo keys at demo.binance.com. This project only permits DEMO/TESTNET.
BINANCE_EXECUTION_VENUE=DEMO            # DEMO | TESTNET (REAL is blocked)
BINANCE_DEMO_API_KEY=your_demo_key_here
BINANCE_DEMO_API_SECRET=your_demo_secret_here
BINANCE_DEMO_REST_URL=https://demo-api.binance.com/api
