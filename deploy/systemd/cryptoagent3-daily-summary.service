[Unit]
Description=CryptoAgent 3.0 concise daily summary of the exposure agent to Slack
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/workplace/cryptoagent3.0
EnvironmentFile=/home/ubuntu/workplace/cryptoagent3.0/.env
Environment=PYTHONPATH=/home/ubuntu/workplace/cryptoagent3.0/src
UMask=0077
ExecStart=/home/ubuntu/workplace/cryptoagent3.0/.venv/bin/python -m scripts.daily_summary --slack --journal /home/ubuntu/workplace/cryptoagent3.0/data/live/exposure-agent-activity.jsonl --policy /home/ubuntu/workplace/cryptoagent3.0/data/models/local-exposure-agent-v1.json --out /home/ubuntu/workplace/cryptoagent3.0/data/live/daily-summary.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/workplace/cryptoagent3.0/data
