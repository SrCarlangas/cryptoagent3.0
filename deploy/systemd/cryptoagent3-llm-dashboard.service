[Unit]
Description=CryptoAgent 3.0 pixel dashboard for the LLM exposure agent (read-only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/workplace/cryptoagent3.0
Environment=PYTHONPATH=/home/ubuntu/workplace/cryptoagent3.0/src
UMask=0077
# Bound to localhost on purpose. The page shows the live position, the book and the
# agent's reasoning, and it has no authentication, so it must be reached over an SSH
# tunnel rather than an exposed port.
ExecStart=/home/ubuntu/workplace/cryptoagent3.0/.venv/bin/python -m scripts.run_llm_dashboard \
  --host 127.0.0.1 \
  --port 8787 \
  --model qwen3:30b-a3b \
  --journal /home/ubuntu/workplace/cryptoagent3.0/data/live/llm-agent-activity.jsonl \
  --memory /home/ubuntu/workplace/cryptoagent3.0/data/live/llm-agent-memory.sqlite3
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
# ProtectSystem=strict already mounts the entire filesystem read-only, so the whole
# project is unwritable except for what is listed below.
ProtectSystem=strict
# data/live must be writable and it is NOT a mistake. The memory database runs in
# WAL mode, and SQLite cannot open a WAL database at all, even read-only, unless it
# can map the -shm shared-memory index next to it. With the directory read-only the
# panel failed deterministically with "unable to open database file".
#
# The read-only guarantee therefore comes from the code, not from the mount: the
# database is opened with SQLite's mode=ro, which refuses writes at the engine level
# (verified: "attempt to write a readonly database"), and the dashboard never calls
# the journal's append path. Do not "restore" ReadOnlyPaths here; it silently breaks
# the reasoning, calibration and measured-pattern panels.
ReadWritePaths=/home/ubuntu/workplace/cryptoagent3.0/data/live

[Install]
WantedBy=multi-user.target
